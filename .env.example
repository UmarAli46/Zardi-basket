# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Safepay Payment Gateway (Sandbox / Production)
SAFEPAY_API_KEY=your-safepay-api-key
SAFEPAY_SECRET_KEY=your-safepay-secret-key
SAFEPAY_WEBHOOK_KEY=your-safepay-webhook-key
NEXT_PUBLIC_SAFEPAY_ENVIRONMENT=sandbox

# Admin Portal Credentials
ADMIN_EMAIL=admin@zardibasket.com
ADMIN_PASSWORD=ZardiAdmin2026!
ADMIN_TOKEN_SECRET=your-secure-random-secret
